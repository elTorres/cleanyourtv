<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Screen" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/screen</item>
        <item name="android:buttonStyle">@style/ScreenButton</item>
    </style>

    <style name="ScreenButton" parent="@android:style/Widget.DeviceDefault.Button.Borderless">
        <item name="android:background">@drawable/button</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
